# Copy this file to ".env" and fill in your camera login.
# .env is read by main.py at startup - never commit it or share it.

RTSP_USERNAME=admin
RTSP_PASSWORD=change_me

# Optional: full RTSP URL. Overrides stream.url in config.yaml.
# If it contains no credentials, RTSP_USERNAME / RTSP_PASSWORD are added.
# RTSP_URL=rtsp://192.168.1.64:554/Streaming/Channels/102
